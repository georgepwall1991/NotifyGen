<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>netstandard2.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <EnforceExtendedAnalyzerRules>true</EnforceExtendedAnalyzerRules>
    <NoWarn>$(NoWarn);RS2008;NU5128</NoWarn>
    <IsRoslynComponent>true</IsRoslynComponent>
    <GenerateAssemblyInfo>true</GenerateAssemblyInfo>

    <!-- NuGet Package Metadata -->
    <PackageId>NotifyGen</PackageId>
    <Version>1.6.0</Version>
    <Authors>George Wall</Authors>
    <Title>NotifyGen - INotifyPropertyChanged Source Generator</Title>
    <Description>A fast INotifyPropertyChanged source generator for .NET. Eliminates MVVM boilerplate with a single [Notify] attribute, no runtime dependency, full IntelliSense, and debuggable generated code.

Features:
• Auto-generates properties with PropertyChanged notifications
• Built-in equality guards prevent redundant events
• Partial hooks: On{Property}Changing(oldValue, newValue) and On{Property}Changed()
• [NotifyAlso] for dependent properties
• [NotifySetter] for access control (private, protected, internal)
• INotifyPropertyChanging support for undo/redo scenarios
• [NotifyCanExecuteChangedFor] for automatic command refresh
• [NotifySuppressable] for batch notification suppression
• Nested [Notify] class support with generic declaration preservation
• Analyzer diagnostics and code fixes for invalid partial declarations
• Works with WPF, MAUI, Blazor, Avalonia, Uno Platform, WinUI, and Xamarin
• AOT compatible and trimming safe</Description>
    <PackageTags>MVVM;INotifyPropertyChanged;INPC;WPF;MAUI;Blazor;Avalonia;Uno;Xamarin;WinUI;UWP;SourceGenerator;CodeGeneration;Roslyn;PropertyChanged;DataBinding;ViewModel;ReactiveUI;dotnet;csharp;boilerplate;code-generator;performance;aot;trimming;android;ios;mac;windows;linux</PackageTags>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageProjectUrl>https://github.com/georgepwall1991/NotifyGen</PackageProjectUrl>
    <RepositoryUrl>https://github.com/georgepwall1991/NotifyGen</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageIcon>icon.png</PackageIcon>
    <PackageReleaseNotes>Unreleased (cycle 1):
• Generate C# 14/preview partial properties from [Notify] without a runtime dependency
• Support [NotifyAlso] on partial properties and reject ambiguous generated names with NOTIFY009
• Expand transitive [NotifyAlso] dependencies with cycle diagnostics (NOTIFY008)

v1.6.0:
• Generate nested [Notify] classes safely across partial containing types
• Add NOTIFY006 with a Make type partial code fix for containing declarations
• Reject static, const, and readonly fields consistently before generation
• Preserve generic syntax, modifiers, escaped identifiers, and collision-safe source hints
• Report NOTIFY003 when [NotifyAlso] targets a property from an ineligible field</PackageReleaseNotes>
    <Copyright>Copyright (c) 2025-2026 George Wall</Copyright>

    <!-- Analyzer/Generator packaging -->
    <DevelopmentDependency>true</DevelopmentDependency>
    <IncludeBuildOutput>false</IncludeBuildOutput>
    <SuppressDependenciesWhenPacking>true</SuppressDependenciesWhenPacking>
  </PropertyGroup>

  <!-- Expose internals to test project -->
  <ItemGroup>
    <InternalsVisibleTo Include="NotifyGen.Tests" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.CodeAnalysis.Analyzers" Version="3.3.4" PrivateAssets="all" />
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp" Version="4.8.0" PrivateAssets="all" />
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp.Workspaces" Version="4.8.0" PrivateAssets="all" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\NotifyGen.Attributes\NotifyGen.Attributes.csproj" PrivateAssets="all" />
  </ItemGroup>

  <!-- Pack the generator and attributes correctly -->
  <ItemGroup>
    <None Include="$(OutputPath)\$(AssemblyName).dll" Pack="true" PackagePath="analyzers/dotnet/cs" Visible="false" />
    <None Include="$(OutputPath)\NotifyGen.Attributes.dll" Pack="true" PackagePath="analyzers/dotnet/cs" Visible="false" />
    <None Include="$(OutputPath)\NotifyGen.Attributes.dll" Pack="true" PackagePath="lib/netstandard2.0" Visible="false" />
    <None Include="..\..\README.md" Pack="true" PackagePath="\" />
    <None Include="..\..\assets\icon.png" Pack="true" PackagePath="\" />
  </ItemGroup>

</Project>
