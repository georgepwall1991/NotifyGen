<Window x:Class="NotifyGen.WpfSample.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:NotifyGen.WpfSample"
        Title="NotifyGen WPF Sample" Height="560" Width="640">
    <Window.DataContext>
        <local:MainViewModel />
    </Window.DataContext>

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="140"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <TextBlock Grid.Row="0" Grid.ColumnSpan="2"
                   Text="NotifyGen — host INPC, child &amp; collection notify"
                   FontSize="18" FontWeight="Bold" Margin="0,0,0,16"/>

        <TextBlock Grid.Row="1" Grid.Column="0" Text="First Name:" VerticalAlignment="Center"/>
        <TextBox Grid.Row="1" Grid.Column="1"
                 Text="{Binding FirstName, UpdateSourceTrigger=PropertyChanged}"
                 Margin="0,4"/>

        <TextBlock Grid.Row="2" Grid.Column="0" Text="Last Name:" VerticalAlignment="Center"/>
        <TextBox Grid.Row="2" Grid.Column="1"
                 Text="{Binding LastName, UpdateSourceTrigger=PropertyChanged}"
                 Margin="0,4"/>

        <TextBlock Grid.Row="3" Grid.Column="0" Text="Full Name:" VerticalAlignment="Center" FontWeight="Bold"/>
        <TextBlock Grid.Row="3" Grid.Column="1"
                   Text="{Binding FullName}"
                   VerticalAlignment="Center" Margin="0,4"
                   Foreground="DarkGreen" FontWeight="Bold"/>

        <TextBlock Grid.Row="4" Grid.Column="0" Text="Age:" VerticalAlignment="Center"/>
        <StackPanel Grid.Row="4" Grid.Column="1" Orientation="Horizontal" Margin="0,4">
            <Slider Value="{Binding Age}" Minimum="0" Maximum="120" Width="220"/>
            <TextBlock Text="{Binding Age}" Margin="10,0" VerticalAlignment="Center"/>
        </StackPanel>

        <TextBlock Grid.Row="5" Grid.Column="0" Text="City:" VerticalAlignment="Center"/>
        <TextBox Grid.Row="5" Grid.Column="1"
                 Text="{Binding Address.City, UpdateSourceTrigger=PropertyChanged}"
                 Margin="0,4"/>

        <TextBlock Grid.Row="6" Grid.Column="0" Text="Tags / Count:" VerticalAlignment="Center"/>
        <TextBlock Grid.Row="6" Grid.Column="1" VerticalAlignment="Center" Margin="0,4">
            <Run Text="{Binding TagCount, Mode=OneWay}"/>
            <Run Text=" tags (membership raises TagCount)"/>
        </TextBlock>

        <Button Grid.Row="7" Grid.ColumnSpan="2"
                Content="Bulk load with SuppressNotifications()"
                Margin="0,12,0,0"
                Padding="8,6"
                Click="BulkLoad_Click"/>

        <GroupBox Grid.Row="8" Grid.ColumnSpan="2" Header="Property Change Log" Margin="0,16,0,0">
            <ScrollViewer>
                <TextBlock Text="{Binding StatusLog}" TextWrapping="Wrap" FontFamily="Consolas"/>
            </ScrollViewer>
        </GroupBox>
    </Grid>
</Window>
